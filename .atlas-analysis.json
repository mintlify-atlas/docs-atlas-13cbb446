  "keyFeatures": [
    "PS4 game library browser and manager with cover art",
    "PKG package installer with background download support",
    "Full game dumper to USB with multi-disc and patch support",
    "Game patches and trainers via XML patch files",
    "Playtime tracking per game with daemon IPC",
    "FTP server built into the daemon for remote file management",
    "NFS network share mounting via FUSE",
    "Custom themes with backgrounds, fonts, and GLES2 shaders",
    "Home menu redirect (replaces default PS4 home screen)",
    "Multi-language support following PS4 system language",
    "Favorites list and sorting/filtering of installed games",
    "Game saves management",
    "MP3 background music playback"
  ],
